<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Baseline for JengoAGI's VersionTrackingService until the first "tag-release" CI
         run (see .github/workflows/ci.yml) pushes a real vX.Y.Z tag, which then takes
         priority over this static value. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="5.9.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="5.9.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IAM.Core\IAM.Core.csproj" />
    <ProjectReference Include="..\IAM.Infrastructure\IAM.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AdminUiRoot>$(MSBuildProjectDirectory)\..\..\admin-ui\</AdminUiRoot>
  </PropertyGroup>

  <!--
    app.UseStaticFiles() + app.MapFallbackToFile("index.html") (Program.cs) serve the SPA from
    wwwroot, but nothing produced wwwroot: admin-ui/dist was never part of this project and a
    plain `dotnet publish` shipped a wwwroot-less app, so /login (and every other client route)
    404'd until someone manually xcopied a dist build onto the deploy target. Build the SPA and
    fold its output into the publish payload so `dotnet publish` alone is sufficient.
  -->
  <Target Name="PublishAdminUi" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(AdminUiRoot)" Condition="!Exists('$(AdminUiRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(AdminUiRoot)" />

    <ItemGroup>
      <AdminUiDistFiles Include="$(AdminUiRoot)dist\**" />
      <ResolvedFileToPublish Include="@(AdminUiDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
