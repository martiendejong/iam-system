{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AccessMatrix": {
    "Applications": [
      {
        "ClientId": "taskmanager",
        "DisplayName": "JengoWork",
        "BaseRole": "taskmanager:developer",
        "Permissions": [
          { "Role": "taskmanager:admin", "Label": "Beheerder", "Description": "Volledig beheer: borden, mappen, rollen, API keys, alle lanes" },
          { "Role": "taskmanager:product-owner", "Label": "Product Owner", "Description": "Backlog, needs-input, acceptance en done lanes" },
          { "Role": "taskmanager:planner", "Label": "Planner", "Description": "Refined t/m to-do lanes" },
          { "Role": "taskmanager:refiner", "Label": "Refiner", "Description": "Backlog en needs-input lanes" },
          { "Role": "taskmanager:tester", "Label": "Tester", "Description": "Testing lane en drop-spots" },
          { "Role": "taskmanager:customer", "Label": "Klant", "Description": "Externe klant, beperkt tot eigen tenant (JengoWork task 460)" }
        ]
      },
      {
        "ClientId": "passwordmanager",
        "DisplayName": "Vault",
        "BaseRole": "app:vault",
        "Permissions": [
          { "Role": "app:vault:approver", "Label": "Approver", "Description": "Mag credential-aanvragen goedkeuren" },
          { "Role": "app:vault:taps", "Label": "TAPs", "Description": "Mag tijdelijke toegangswachtwoorden uitgeven" }
        ]
      },
      {
        "ClientId": "jengo-agi",
        "DisplayName": "Jengo AGI dashboard",
        "BaseRole": "JengoAdmin",
        "Permissions": []
      },
      {
        "ClientId": "jengo-workspace",
        "DisplayName": "Workspace",
        "BaseRole": "app:workspace",
        "Permissions": []
      },
      {
        "ClientId": "jengomail",
        "DisplayName": "JengoMail",
        "BaseRole": "app:jengomail",
        "Permissions": [
          { "Role": "app:jengomail:admin", "Label": "Beheerder", "Description": "Beheerrechten in JengoMail" }
        ]
      },
      {
        "ClientId": "fedha",
        "DisplayName": "Fedha (boekhouding)",
        "BaseRole": "app:fedha",
        "Permissions": [
          { "Role": "app:fedha:admin", "Label": "Beheerder", "Description": "Beheerrechten in Fedha" }
        ]
      },
      {
        "ClientId": "ari-chat",
        "DisplayName": "ARI chat",
        "BaseRole": "app:ari",
        "Permissions": []
      },
      {
        "ClientId": "intranet-portal",
        "DisplayName": "Intranet portal",
        "BaseRole": "app:intranet",
        "Permissions": []
      }
    ]
  }
}
