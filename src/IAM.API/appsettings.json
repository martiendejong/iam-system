{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AccessMatrix": {
    "Applications": [
      {
        "ClientId": "taskmanager",
        "DisplayName": "JengoWork",
        "BaseRole": "app:jengowork",
        "Permissions": [
          { "Role": "app:jengowork:admin", "Label": "Beheerder", "Description": "Volledige beheerrechten in JengoWork" },
          { "Role": "app:jengowork:boards:all", "Label": "Alle borden", "Description": "Toegang tot alle borden" },
          { "Role": "app:jengowork:boards:readonly", "Label": "Borden alleen-lezen", "Description": "Alleen-lezen toegang tot borden" }
        ]
      },
      {
        "ClientId": "passwordmanager",
        "DisplayName": "Vault",
        "BaseRole": "app:vault",
        "Permissions": [
          { "Role": "app:vault:approver", "Label": "Approver", "Description": "Mag credential-aanvragen goedkeuren" },
          { "Role": "app:vault:taps", "Label": "TAPs", "Description": "Mag tijdelijke toegangswachtwoorden uitgeven" }
        ]
      },
      {
        "ClientId": "jengo-agi",
        "DisplayName": "Jengo AGI dashboard",
        "BaseRole": "JengoAdmin",
        "Permissions": []
      },
      {
        "ClientId": "jengo-workspace",
        "DisplayName": "Workspace",
        "BaseRole": "app:workspace",
        "Permissions": []
      },
      {
        "ClientId": "jengomail",
        "DisplayName": "JengoMail",
        "BaseRole": "app:jengomail",
        "Permissions": [
          { "Role": "app:jengomail:admin", "Label": "Beheerder", "Description": "Beheerrechten in JengoMail" }
        ]
      },
      {
        "ClientId": "fedha",
        "DisplayName": "Fedha (boekhouding)",
        "BaseRole": "app:fedha",
        "Permissions": [
          { "Role": "app:fedha:admin", "Label": "Beheerder", "Description": "Beheerrechten in Fedha" }
        ]
      },
      {
        "ClientId": "ari-chat",
        "DisplayName": "ARI chat",
        "BaseRole": "app:ari",
        "Permissions": []
      },
      {
        "ClientId": "intranet-portal",
        "DisplayName": "Intranet portal",
        "BaseRole": "app:intranet",
        "Permissions": []
      }
    ]
  }
}
