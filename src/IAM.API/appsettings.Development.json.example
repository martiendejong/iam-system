{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=iamdb;Username=iamuser;Password=<YOUR_DB_PASSWORD>"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "<REPLACE_WITH_32_CHAR_MIN_RANDOM_SECRET>",
    "Issuer": "https://localhost:5001",
    "Audience": "iam-api",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Fido2": {
    "ServerDomain": "localhost",
    "ServerName": "IAM System - Development",
    "Origins": [
      "https://localhost:5161",
      "http://localhost:5173"
    ],
    "TimestampDriftTolerance": 300000
  },
  "Clients": {
    "OpenWebUi": {
      "Secret": "<REPLACE_WITH_OPEN_WEBUI_CLIENT_SECRET>"
    }
  },
  "Ca": {
    "_comment": "Optional in Development (a documented dev-only password is used). Required in every other environment: a strong generated CertificatePassword protects the CA root key file; CertificatePath defaults outside the app folder. LegacyCertificatePassword is a one-time setting to upgrade a key file made by an older version (remove it after the first start).",
    "CertificatePassword": "<REPLACE_WITH_STRONG_GENERATED_PASSWORD>"
  },
  "JengoVpsMcp": {
    "ClientSecret": "jengo-mcp-iam-secret-dev"
  }
}
