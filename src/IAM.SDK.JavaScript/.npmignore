# NPM Ignore - Exclude source files and dev dependencies

# Source files (we ship dist/ only)
src/
tsconfig.json

# Development files
node_modules/
*.log
*.tgz

# Tests
**/*.test.ts
**/*.spec.ts
coverage/
.vitest/

# Development configs
.eslintrc*
.prettierrc*
vitest.config.ts

# Git files
.git/
.gitignore

# Documentation (include README.md only)
docs/
examples/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
