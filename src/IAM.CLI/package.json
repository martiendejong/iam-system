  },
  "homepage": "https://github.com/martiendejong/iam-system#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "enquirer": "^2.4.1",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "execa": "^5.1.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
