# Copy to .env (git-ignored) and fill in. docker compose refuses to start without these.
# Generate a strong value:  openssl rand -hex 24
#   (PowerShell: -join ((1..24) | % { '{0:x2}' -f (Get-Random -Max 256) }))
# Hex/alphanumeric values only, so they drop into connection strings without escaping.
IAM_POSTGRES_PASSWORD=<generate-a-strong-value>
IAM_REDIS_PASSWORD=<generate-a-strong-value>
