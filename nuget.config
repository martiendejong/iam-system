<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Jengo.Mcp.AspNetCore (shared MCP template, scp-jengo/jengo-mcp-template) is vendored as a
         .nupkg under src/IAM.API/nuget-local, so restore needs no private feed or sibling checkout.
         Upgrade = drop in the new .nupkg + bump the PackageReference version. nuget.org (from the
         machine-level config) stays available for everything else: this file adds a source and
         deliberately does not <clear/>. -->
    <add key="jengo-local" value="src/IAM.API/nuget-local" />
  </packageSources>
</configuration>
