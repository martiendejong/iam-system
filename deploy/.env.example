# IAM deployment environment variables
# Copy this file to .env and fill in values before starting the stack.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=iam
DB_PASSWORD=change-me-strong-password
DB_NAME=iam_db

# ── App environment ───────────────────────────────────────────────────────────
# Development: uses ephemeral OpenIddict certs (no PFX files needed).
# Production:  requires OPENIDDICT_* cert vars below.
APP_ENV=Development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match the public base URL Caddy serves (trailing slash is optional).
JWT_ISSUER=https://iam-test.martiendejong.nl
# Minimum 32 characters; keep in vault.
JWT_SECRET_KEY=change-me-at-least-32-chars-long!!
# Audience claim embedded in and expected by access tokens. Must be consistent.
JWT_AUDIENCE=iam-api

# ── WebAuthn / Passkeys ───────────────────────────────────────────────────────
FIDO2_DOMAIN=iam-test.martiendejong.nl
FIDO2_ORIGIN=https://iam-test.martiendejong.nl

# ── Secrets vault ────────────────────────────────────────────────────────────
# Base64-encoded 32-byte key. Generate with:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SecretsVault__MasterKey=

# ── Seeded OAuth clients (required in Production; optional in Development) ────
# Random 32-char strings; store in vault.
Clients__OpenWebUi__Secret=
JengoVpsMcp__ClientSecret=
JengoAgiSvc__ClientSecret=
Clients__SquidProxy__Secret=

# ── Admin seed user ───────────────────────────────────────────────────────────
# Created on first startup if not already present.
AdminSeed__Email=
AdminSeed__Password=
AdminSeed__FirstName=Admin
AdminSeed__LastName=User

# ── Standalone customer IAM at a HOST ROOT (optional) ─────────────────────────
# Leave all of these unset for the /auth deployment: defaults reproduce today's behaviour exactly.
# Example: customer IAM at https://tn-auth.example.nl (no /auth prefix, no gateway rewrite).
# Build the image with the SPA at the root (this is also the Dockerfile default):
#   docker build --build-arg VITE_BASE_PATH=/ -t iam-system:latest .
# Public base URL = issuer, host root:
#   JWT_ISSUER=https://tn-auth.example.nl
# Browser-visible path of the SPA login page that /connect/authorize redirects to (default /auth/login):
# UI_LOGIN_PATH=/login
# CORS: when any CORS_ORIGIN_n is set, EXACTLY these origins are allowed (our own hardcoded ones are
# dropped). Slots 0..5. Leave all empty to keep the built-in list.
# CORS_ORIGIN_0=https://tasks.example.nl
# CORS_ORIGIN_1=https://kb.example.nl
# CORS_ORIGIN_2=https://meet.example.nl
# CORS_ORIGIN_3=https://agi.example.nl
# Seed only react_admin_ui, roles/scopes/audiences and the admin user; skip our product OAuth clients
# and the WordPress SSO seeder (no Clients__* secrets needed then):
# SEEDER_SKIP_INTERNAL_CLIENTS=true
# Public PKCE clients for the customer's own apps, one JSON array on ONE line. Created when missing
# (authorization_code + refresh_token, scopes openid profile email roles, PKCE, implicit consent);
# when the client exists only its redirect URIs are updated. Replaces manual SQL.
# SEEDER_EXTRA_PUBLIC_CLIENTS_JSON='[{"ClientId":"taskmanager","DisplayName":"Taskmanager","RedirectUris":["https://tasks.example.nl/api/auth/callback"],"PostLogoutRedirectUris":["https://tasks.example.nl/"]},{"ClientId":"jengo-knowledge","DisplayName":"Jengo Knowledge","RedirectUris":["https://kb.example.nl/api/auth/callback"],"PostLogoutRedirectUris":["https://kb.example.nl/"]},{"ClientId":"jengo-meeting","DisplayName":"Jengo Meeting","RedirectUris":["https://meet.example.nl/api/auth/callback"],"PostLogoutRedirectUris":["https://meet.example.nl/"]},{"ClientId":"jengo-agi","DisplayName":"Jengo AGI","RedirectUris":["https://agi.example.nl/api/auth/callback"],"PostLogoutRedirectUris":["https://agi.example.nl/"]}]'

# ── Email (disable for test environments) ────────────────────────────────────
Email__AllowDisabledSending=true

# ── OpenIddict certs (Production only) ────────────────────────────────────────
# Generate with:  openssl req -x509 -newkey rsa:4096 -days 3650 -nodes \
#                   -keyout signing.key -out signing.crt
#                 openssl pkcs12 -export -out /opt/iam/certs/signing.pfx \
#                   -inkey signing.key -in signing.crt -passout pass:$PASS
# OPENIDDICT_SIGNING_CERT_PASSWORD=
# OPENIDDICT_ENCRYPTION_CERT_PASSWORD=
