# IAM deployment environment variables
# Copy this file to .env and fill in values before starting the stack.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=iam
DB_PASSWORD=change-me-strong-password
DB_NAME=iam_db

# ── App environment ───────────────────────────────────────────────────────────
# Development: uses ephemeral OpenIddict certs (no PFX files needed).
# Production:  requires OPENIDDICT_* cert vars below.
APP_ENV=Development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match the public base URL Caddy serves (trailing slash is optional).
JWT_ISSUER=https://iam-test.martiendejong.nl
# Minimum 32 characters; keep in vault.
JWT_SECRET_KEY=change-me-at-least-32-chars-long!!

# ── WebAuthn / Passkeys ───────────────────────────────────────────────────────
FIDO2_DOMAIN=iam-test.martiendejong.nl
FIDO2_ORIGIN=https://iam-test.martiendejong.nl

# ── OpenIddict certs (Production only) ────────────────────────────────────────
# Generate with:  openssl req -x509 -newkey rsa:4096 -days 3650 -nodes \
#                   -keyout signing.key -out signing.crt
#                 openssl pkcs12 -export -out /opt/iam/certs/signing.pfx \
#                   -inkey signing.key -in signing.crt -passout pass:$PASS
# OPENIDDICT_SIGNING_CERT_PASSWORD=
# OPENIDDICT_ENCRYPTION_CERT_PASSWORD=
